{
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "skipLibCheck": true,
        "allowJs": true,
        "strict": true,
        "strictPropertyInitialization": false,
        "moduleResolution": "bundler",
        "paths": {
            "zqm/zqmolabel/*": [
                "./webapp/*"
            ]
        },
        "types": [
            "@sapui5/types"
        ]
    },
    "include": [
        "./webapp/**/*"
    ],
    "exclude": [
        "./webapp/test/**/*"
    ]
}